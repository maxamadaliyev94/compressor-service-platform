# База данных
DATABASE_URL="postgresql://user:password@localhost:5432/compressor_service"

# Авторизация (NextAuth)
NEXTAUTH_SECRET="your-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Хранилище файлов (Supabase Storage или S3)
STORAGE_URL="https://your-project.supabase.co/storage/v1"
STORAGE_KEY="your-storage-key"
STORAGE_BUCKET="compressor-files"

# Telegram бот (уведомления)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Email (уведомления и отправка актов)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@compressor-service.com"

# Карты
YANDEX_MAPS_API_KEY="your-yandex-maps-key"

# URL приложения
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
