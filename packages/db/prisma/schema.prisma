generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CHIEF_ENGINEER
  ENGINEER
  CLIENT
}

enum ClientStatus {
  VIP
  STANDART
  PASSIVE
}

enum EquipmentType {
  COMPRESSOR
  DRYER
  RECEIVER
  FILTER
  NITROGEN_GENERATOR
  OTHER
}

enum EquipmentStatus {
  WORKING
  STOPPED
  REPAIR
  PRESERVED
  DECOMMISSIONED
}

enum WarrantyVoidReason {
  LATE_MAINTENANCE
  NON_ORIGINAL_PARTS
  SELF_REPAIR
  POOR_VENTILATION
  OVERHEATING
  VOLTAGE_SURGE
  DIRTY_RADIATOR
  OPERATION_VIOLATION
  OTHER
}

enum TaskType {
  PLANNED_MAINTENANCE
  DIAGNOSTICS
  WARRANTY_REPAIR
  EMERGENCY
  INSTALLATION
  COMMISSIONING
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum TaskStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  DRAFT
  REVIEW
  DONE
  REVISION
  CANCELLED
}

/// Быстрая (обычный цикл) или долгосрочная задача (ежедневные записи, закрытие только ГИ).
enum TaskWorkType {
  QUICK
  LONG_TERM
}

/// Статус участия инженера в задаче (в т.ч. быстрая с несколькими исполнителями).
enum TaskParticipantStatus {
  ASSIGNED
  IN_PROGRESS
  DONE
}

enum AttachmentType {
  BEFORE
  AFTER
  NAMEPLATE
  PROBLEM_AREA
  OTHER
}

enum ChatRoomType {
  GENERAL
  DIRECT
  TASK
  COMMENTS
}

enum ChecklistItemType {
  CONTROL
  WORK
  PART
}

/// Действие по пункту чек-листа (актуально для задач «Диагностика»).
enum ChecklistItemAction {
  REPLACE
  TOP_UP
  REPAIR
}

model User {
  id         String   @id @default(cuid())
  login      String   @unique
  email      String?  @unique
  password   String
  name       String
  avatarUrl  String?
  /// PNG data URL — шаблон подписи инженера на акты (подстановка / Face ID).
  savedActSignature String? @db.Text
  role       Role     @default(ENGINEER)
  phone      String?
  telegramId String?
  isActive   Boolean  @default(true)
  isOnline   Boolean  @default(false)
  checkedInAt DateTime?
  checkedOutAt DateTime?
  engineerStatus String @default("FREE")
  lastLoginAt DateTime?
  clientId      String?
  /// Принудительный сброс сессий: JWT, выданные раньше этого времени, считаются недействительными.
  sessionInvalidatedAt DateTime?
  /// Временная блокировка входа (суперадмин), без удаления учётной записи.
  loginSuspendedByAdmin Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userActivities UserActivity[]
  userSessions   UserSession[]

  assignedTasks ServiceTask[] @relation("AssignedEngineer")
  createdTasks  ServiceTask[] @relation("TaskCreator")
  deletedTasks  ServiceTask[] @relation("TaskDeleter")
  managedLongTermTasks ServiceTask[] @relation("LongTermManagedBy")
  dailyWorkEntries DailyWork[]
  longTermTaskAssignments LongTermTaskEngineer[]
  managedClients Client[] @relation("ClientManager")
  clientAccount Client? @relation("ClientPortalUsers", fields: [clientId], references: [id], onDelete: SetNull)
  clientNotifySubscriptions Client[] @relation("ClientAttachedNotifyUser")
  workReports   WorkReport[]
  auditLogs     AuditLog[]
  notifications Notification[]
  rolePermissionsUpdated RolePermission[] @relation("RolePermissionUpdatedBy")
  webauthnCredentials WebAuthnCredential[]
  chatMessages ChatMessage[]
  chatReadStates ChatRoomReadState[]
  chatHiddenRooms ChatRoomHidden[]

  @@map("users")
}

/// Журнал действий пользователей для суперадмин-панели.
model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  page      String?
  ip        String?
  userAgent String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("user_activities")
}

/// Браузерная сессия (устройство, гео по IP, длительность).
model UserSession {
  id          String    @id @default(cuid())
  userId      String
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  endedAt     DateTime?
  ip          String?
  userAgent   String?   @db.Text
  deviceType  String?
  browserName String?
  city        String?
  country     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@index([endedAt])
  @@map("user_sessions")
}

model WebAuthnCredential {
  id                    String   @id @default(cuid())
  userId                String
  credentialID          String   @unique
  credentialPublicKey   Bytes
  counter               Int      @default(0)
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String
  label       String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String   @id @default(cuid())
  role          Role
  permissionId  String
  allowed       Boolean  @default(false)
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  updatedBy  User?      @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model Client {
  id            String       @id @default(cuid())
  managerId     String?
  /// Пользователь, которому слать уведомления о работах по этому клиенту (задачи на оборудовании клиента).
  attachedNotifyUserId String?
  name          String
  inn           String?
  contactPerson String?
  phone         String?
  email         String?
  status        ClientStatus @default(STANDART)
  /// Ручное включение/отключение клиента (не связано с полем status).
  isActive      Boolean      @default(true)
  comment       String?
  country       String       @default("Узбекистан")
  city          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  manager  User?    @relation("ClientManager", fields: [managerId], references: [id])
  attachedNotifyUser User? @relation("ClientAttachedNotifyUser", fields: [attachedNotifyUserId], references: [id], onDelete: SetNull)
  branches Branch[]
  portalUsers User[] @relation("ClientPortalUsers")

  @@map("clients")
}

/// Справочник городов для форм клиента (значение в `Client.city` — строка с названием).
model City {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("cities")
}

/// Единственная строка настроек приложения (глобальное вкл/выкл, подписка).
model AppSettings {
  id       String  @id @default("default")
  isActive Boolean @default(true)
  /// Начало периода подписки (календарная дата UTC).
  subscriptionStart DateTime? @db.Date
  /// Конец периода подписки включительно (UTC); после этой даты доступ блокируется.
  subscriptionEnd   DateTime? @db.Date
  /// Запланированные технические работы: начало (момент времени).
  maintenanceStart DateTime?
  /// Запланированные технические работы: окончание.
  maintenanceEnd   DateTime?
  /// Текст для баннера и страницы блокировки.
  maintenanceMessage String? @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model Branch {
  id            String   @id @default(cuid())
  clientId      String
  name          String
  address       String?
  latitude      Float?
  longitude     Float?
  contactPerson String?
  phone         String?
  workingHours  String?
  createdAt     DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  objects Object[]

  @@map("branches")
}

model Object {
  id            String   @id @default(cuid())
  branchId      String
  name          String
  description   String?
  contactPerson String?
  createdAt     DateTime @default(now())

  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  equipment Equipment[]

  @@map("objects")
}

model Equipment {
  id                 String              @id @default(cuid())
  objectId           String
  /// Код типа из справочника `EquipmentTypeRef.name`.
  type               String
  brand              String
  model              String
  serialNumber       String              @unique
  yearOfManufacture  Int?
  saleDate           DateTime?
  installDate        DateTime?
  warrantyUntil      DateTime?
  warrantyVoided     Boolean             @default(false)
  warrantyVoidReason WarrantyVoidReason?
  currentHours       Float               @default(0)
  lastServiceHours   Int?
  lastServiceDate    DateTime?
  nextServiceHours   Int?
  nextServiceDate    DateTime?
  /// Настроенный режим работы для автоматического прироста моточасов.
  hoursPerDay        Float?              @map("hours_per_day")
  daysPerWeek        Float?              @map("days_per_week")
  /// Давление (бар), необязательно.
  pressureBar        Float?              @map("pressure_bar")
  status             EquipmentStatus     @default(WORKING)
  qrCode             String?             @unique
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  object Object        @relation(fields: [objectId], references: [id], onDelete: Cascade)
  tasks  ServiceTask[]
  photos EquipmentPhoto[]

  @@map("equipment")
}

model EquipmentPhoto {
  id          String   @id @default(cuid())
  equipmentId String
  url         String
  createdAt   DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@map("equipment_photos")
}

model ServiceTask {
  id           String       @id @default(cuid())
  requestNumber Int
  equipmentId  String
  assignedToId String?
  createdById  String
  /// Код типа работы из справочника `WorkTypeRef.code`.
  type         String
  /// Быстрая или долгосрочная задача (колонка в БД: task_type).
  taskType     TaskWorkType @default(QUICK) @map("task_type")
  /// Главный инженер, ответственный за долгосрочную задачу (назначение/переназначение исполнителей).
  managedByChiefId String?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(NEW)
  scheduledAt  DateTime?
  /// Дата начала работ (долгосрочная задача), календарный день.
  startDate    DateTime?    @map("start_date") @db.Date
  /// Планируемая дата окончания (долгосрочная задача).
  endDate      DateTime?    @map("end_date") @db.Date
  completedAt  DateTime?
  comment      String?
  cancelReason String?
  deletedAt    DateTime?
  deletedById  String?
  deletedStatus TaskStatus?
  engineerSignature String?
  clientSignature   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  equipment  Equipment   @relation(fields: [equipmentId], references: [id])
  assignedTo User?       @relation("AssignedEngineer", fields: [assignedToId], references: [id])
  createdBy  User        @relation("TaskCreator", fields: [createdById], references: [id])
  deletedBy  User?       @relation("TaskDeleter", fields: [deletedById], references: [id])
  managedByChief User?  @relation("LongTermManagedBy", fields: [managedByChiefId], references: [id], onDelete: SetNull)
  report     WorkReport?
  dailyWorks DailyWork[]
  longTermEngineers LongTermTaskEngineer[]
  chatRoom ChatRoom?

  @@map("service_tasks")
  @@index([requestNumber])
}

model ChatRoom {
  id        String       @id @default(cuid())
  type      ChatRoomType
  /// Ключ для личного чата: два id пользователей через «:» в лексикографическом порядке.
  dmKey     String?      @unique
  taskId    String?      @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  ChatMessage[]
  task      ServiceTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  readStates ChatRoomReadState[]
  hiddenBy ChatRoomHidden[]

  @@index([type])
  @@map("chat_rooms")
}

model ChatRoomReadState {
  userId     String
  roomId     String
  lastReadAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@map("chat_room_read_states")
}

model ChatRoomHidden {
  userId    String
  roomId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@map("chat_room_hiddens")
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  authorId  String
  body      String   @db.Text
  isSystem  Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  deletedAt DateTime?
  editedAt  DateTime?

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

/// Назначенные на задачу инженеры (долгосрочная или быстрая с совместным выполнением).
model LongTermTaskEngineer {
  id                  String                @id @default(cuid())
  taskId              String
  engineerId          String
  participationStatus TaskParticipantStatus @default(ASSIGNED) @map("participation_status")
  createdAt           DateTime              @default(now())

  task     ServiceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  engineer User        @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([taskId, engineerId])
  @@index([taskId])
  @@map("long_term_task_engineers")
}

/// Ежедневная запись по долгосрочной задаче (чек-лист + заметки за день).
model DailyWork {
  id          String   @id @default(cuid())
  taskId      String
  engineerId  String
  date        DateTime @db.Date
  description String   @db.Text
  checklist   Json     @default("[]")
  createdAt   DateTime @default(now())

  task     ServiceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  engineer User        @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([taskId, engineerId, date])
  @@index([taskId])
  @@map("daily_work")
}

model WorkReport {
  id                String    @id @default(cuid())
  taskId            String    @unique
  engineerId        String
  /// Список id инженеров, участвовавших в выполнении (JSON-массив строк), для акта при совместной работе.
  participantEngineerIds Json? @map("participant_engineer_ids")
  startedAt         DateTime
  finishedAt        DateTime?
  currentHours      Int
  pressure          Float?
  oilTemp           Float?
  airTemp           Float?
  roomCondition     String?
  notes             String?
  recommendations   String?
  nextServiceHours  Int?
  nextServiceDate   DateTime?
  clientSignature   String?
  engineerSignature String?
  engineerSignedAt  DateTime?
  clientSignedAt    DateTime?
  pdfUrl            String?
  actNumber         String?   @unique
  createdAt         DateTime  @default(now())

  task           ServiceTask     @relation(fields: [taskId], references: [id])
  engineer       User            @relation(fields: [engineerId], references: [id])
  checklistItems ChecklistItem[]
  partsUsed      PartUsed[]
  attachments    Attachment[]

  @@map("work_reports")
}

model ChecklistItem {
  id                String             @id @default(cuid())
  reportId          String
  label             String
  checked           Boolean            @default(false)
  itemType          ChecklistItemType  @default(CONTROL)
  order             Int                @default(0)
  /// Заполняется при выполнении диагностики (выбор инженера).
  performedAction   ChecklistItemAction?

  report WorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

model PartUsed {
  id       String  @id @default(cuid())
  reportId String
  name     String
  article  String?
  unit     String  @default("шт")
  quantity Float

  report WorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("parts_used")
}

model Attachment {
  id        String         @id @default(cuid())
  reportId  String
  url       String
  type      AttachmentType @default(OTHER)
  caption   String?
  createdAt DateTime       @default(now())

  report WorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

enum RegulationTaskScope {
  QUICK
  LONG_TERM
}

model MaintenanceRegulation {
  id            String              @id @default(cuid())
  name          String
  /// Код типа оборудования из справочника `EquipmentTypeRef.name`.
  equipmentType String              @default("COMPRESSOR")
  intervalHours Int
  /// Код типа работы из справочника `WorkTypeRef.code`.
  taskType      String              @default("PLANNED_MAINTENANCE")
  /// Быстрые задачи (акт) или долгосрочные (дневной журнал).
  taskScope     RegulationTaskScope @default(QUICK)
  description   String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  items         MaintenanceRegulationItem[]

  @@map("maintenance_regulations")
}

model MaintenanceRegulationItem {
  id           String            @id @default(cuid())
  regulationId String
  label        String
  itemType     ChecklistItemType @default(CONTROL)
  order        Int               @default(0)
  isRequired   Boolean           @default(true)

  regulation MaintenanceRegulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)

  @@map("maintenance_regulation_items")
}

model EquipmentBrandRef {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("equipment_brand_refs")
}

model EquipmentTypeRef {
  id        String   @id @default(cuid())
  name      String   @unique
  nameRu    String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("equipment_type_refs")
}

/// Справочник типов работ (чек-листы, регламенты ТО).
model WorkTypeRef {
  id        String   @id @default(cuid())
  code      String   @unique
  nameRu    String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("work_type_refs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldValue  String?
  newValue  String?
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
